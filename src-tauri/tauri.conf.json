{
    "productName": "V204 VPN",
    "version": "3.3.3",
    "identifier": "com.v204.vpn",
    "build": {
        "beforeDevCommand": null,
        "beforeBuildCommand": null,
        "frontendDist": "../src/renderer"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "V204 VPN",
                "width": 480,
                "height": 720,
                "decorations": false,
                "transparent": false,
                "fullscreen": false,
                "resizable": false,
                "visible": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost",
            "capabilities": [
                "default"
            ]
        },
        "trayIcon": {
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "resources": {
            "../resources/xray/": "xray/"
        },
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1",
                    "librsvg2-common"
                ],
                "desktopTemplate": null
            }
        },
        "category": "Utility",
        "windows": {
            "nsis": {
                "installMode": "both",
                "languages": [
                    "Turkish",
                    "English"
                ],
                "displayLanguageSelector": true
            }
        }
    }
}